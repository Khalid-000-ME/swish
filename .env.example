# Everything below is optional. Bind runs fully in disclosed sandbox/
# simulated mode with none of these set — see the badges in the console
# ("scripted", "mock fixture", "simulated", "Sandbox mode") for what's live
# vs. standing in for it at any given moment.

# --- Agent model, cheapest first ------------------------------------------
# Groq's free tier (openai/gpt-oss-120b) if set; else Anthropic if set;
# else a deterministic scripted stand-in calling the identical tool
# sequence with no key at all. See agent/index.ts.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Sui ------------------------------------------------------------------
SUI_NETWORK=testnet
# Which network the UI's explorer links point at.
NEXT_PUBLIC_SUI_NETWORK=testnet
# Talks gRPC, not JSON-RPC — the public testnet fullnode has fully retired
# JSON-RPC (every method 404s now, including basic health checks), even
# though `sui client gas` keeps working because the CLI already speaks
# gRPC. Override only if you're pointing at a different fullnode.
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
# An address with real testnet SUI, used to run genuine simulateTransaction
# calls for the "hidden effects" diff demo even before the bind package is
# published. Defaults to the repo's own dev address if unset.
BIND_DEMO_SENDER=

# Set all five of these together (see scripts/deploy.sh) to move minting
# and execution from simulated to real on-chain calls against a published
# `bind` package and a shared, funded Vault<SUI>.
BIND_PACKAGE_ID=
BIND_REGISTRY_ID=
BIND_VAULT_ID=
BIND_AGENT_CAP_ID=
BIND_EXECUTOR_KEY=

# The backend's ed25519 attestation key (hex, no 0x, or a bech32
# `suiprivkey1...`). Unset: an ephemeral key is generated per process and
# logged once — fine for a demo, not for anything real.
BIND_ATTEST_PRIVKEY=

# Seals each agent's Ed25519 secret at rest (AES-256-GCM).
# 32 bytes of hex: openssl rand -hex 32
# Unset: agents still get a real address and can receive, but nothing
# can sign for them.
BIND_AGENT_KEY_SECRET=

# --- Intercepta -----------------------------------------------------------
# Unset: lib/intercepta.ts screens against fixtures/flagged-address.ts instead.
INTERCEPTA_API_KEY=

# --- World ----------------------------------------------------------------
# Real World ID needs all four. Without them the UI shows a clearly
# labelled "Simulate verification" control instead of a button that
# claims to verify and doesn't — see /api/world/config.
#   WORLD_APP_ID          app_... from the Developer Portal
#   WORLD_ACTION          the action id you registered
#   WORLD_RP_ID           your registered relying-party id
#   WORLD_RP_PRIVATE_KEY  PEM EC private key — signs rp_context server-side
WORLD_APP_ID=
WORLD_ACTION=
WORLD_RP_ID=
WORLD_RP_PRIVATE_KEY=
# World ID for Agents (the override path) — OIDC, not the IDKit widget.
# Unset: the sandbox flow's redirect points back at our own callback route
# instead of id.worldcoin.org, and the UI shows an in-page approve/deny
# control instead of a real World redirect.
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
